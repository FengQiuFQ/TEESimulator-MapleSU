.class public Lorg/bouncycastle/jcajce/provider/symmetric/AES$WrapPad256;
.super Lorg/bouncycastle/jcajce/provider/symmetric/util/BaseWrapCipher;


# direct methods
.method public constructor <init>()V
    .registers 2

    new-instance v0, Lv0/c;

    invoke-direct {v0}, Lv0/c;-><init>()V

    invoke-direct {p0, v0}, Lorg/bouncycastle/jcajce/provider/symmetric/util/BaseWrapCipher;-><init>(Lorg/bouncycastle/crypto/p0;)V

    return-void
.end method
